{
	"name": "pl_ingest_visualcrossing_landing_dev_daily",
	"properties": {
		"activities": [
			{
				"name": "copy_visualcrossing_to_landing",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "current_date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_json_visualcrossing_src_dev",
						"type": "DatasetReference",
						"parameters": {
							"city": {
								"value": "@pipeline().parameters.city",
								"type": "Expression"
							},
							"date": {
								"value": "@variables('date')",
								"type": "Expression"
							},
							"apiKey": {
								"value": "@activity('web_get_apikey').output.value",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_jason_visualcrossing_landing_dev",
						"type": "DatasetReference",
						"parameters": {
							"city": {
								"value": "@pipeline().parameters.city",
								"type": "Expression"
							},
							"data": {
								"value": "@variables('date')",
								"type": "Expression"
							},
							"file_name": {
								"value": "@tolower(concat('atmos_',pipeline().parameters.city,'_',formatDateTime(utcNow(),'yyyyMMddhhmmss'),'.json'))",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "web_get_apikey",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kv-atmos-dev-westus2-00.vault.azure.net/secrets/visualcrossing-api-key-dev/067556d873ce4bb085650e2488c8000b?api-version=7.4",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "current_date",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "web_get_apikey",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "date",
					"value": "@utcNow('yyyyMMdd')"
				}
			}
		],
		"parameters": {
			"city": {
				"type": "string"
			}
		},
		"variables": {
			"date": {
				"type": "String"
			}
		},
		"folder": {
			"name": "visualcrossing"
		},
		"annotations": []
	}
}