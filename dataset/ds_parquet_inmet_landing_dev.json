{
	"name": "ds_parquet_inmet_landing_dev",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ls_adlsg2_atmos_dev",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"ano": {
				"type": "string"
			},
			"file_name": {
				"type": "string"
			},
			"id_estacao": {
				"type": "string"
			},
			"tipo_dado": {
				"type": "string"
			}
		},
		"folder": {
			"name": "INMET"
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().file_name",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@if(\n\tequals(dataset().tipo_dado, 'estacao'),\n\t'landing/inmet/estacao',\n\ttoLower(concat('landing/inmet/microdados/id_estacao=', dataset().id_estacao, '/ano=', string(dataset().ano)))\n)",
					"type": "Expression"
				},
				"fileSystem": "atmos-landing-dev-001v2"
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	}
}